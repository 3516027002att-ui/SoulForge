# Per-assistant instruction files and local tool metadata. These are machine-local
# operator config, not project scope: they differ per developer and per tool, so a
# commit of one silently imposes one operator's setup on everyone else. Derived
# copies (CLAUDE.md.bak-*, AGENTS.md.orig, ...) are covered too — a backup of an
# ignored file is just as local as the original, and leaving it untracked also
# poisons the handoff fingerprint's untracked manifest.
AGENTS.md
AGENTS.md.*
CLAUDE.md
CLAUDE.md.*
GEMINI.md
GEMINI.md.*
QWEN.md
QWEN.md.*
.cursorrules
.windsurfrules
.github/copilot-instructions.md
.claude/
.codex/
.gemini/
.qwen/
.cursor/
.gitattributes
graphify-out/
mcps/
.playwright-cli/
.playwright-mcp/
.workbuddy/
.kiro/
.zcode/
output/
.ai-bridge/
problem/
docx/
research/
test-results/
playwright-report/
tmp/
.tmp/
release/
锐评/
mission/
*.mdz
*.log
.*.log

# One-off local generation scratch files.
scripts/_tmp_*
scripts/_gen_*.py
packages/core/src/scene/_inventory_ext.ts.txt

# Mis-compiled TypeScript output landing inside src/. Every package compiles with
# rootDir=src/outDir=dist, so any emit under src/ is a stray single-file `tsc`
# invocation. Leaving it untracked poisons the handoff fingerprint's untracked
# manifest, so it is ignored outright. Hand-authored declarations stay tracked.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
!apps/desktop/src/renderer/src/global.d.ts

# Local dev launcher (compiled from scripts/launch-soulforge.cs). Do not commit binaries.
/SoulForge.exe
/SoulForge.Doctor.exe
/SoulForge.Launcher.exe
*.pdb

# IDE and assistant local directories
.kiro/
.playwright-mcp/
.zcode/

# Electron/app artifacts
release/
*.log
!docs/ai-logs/**

# Playwright transient artifacts
/test-results/
apps/desktop/e2e/playwright/playwright-report/
apps/desktop/e2e/playwright/test-results/
apps/desktop/test-results/
apps/desktop/.native/

# Local real game/mod samples and private fixture evidence. Never commit them.
mods/
Sekiro Shadows Die Twice/
testdata/native-fixtures/


# .NET
bin/
obj/
*.user
*.suo
.vs/
