锐评/
/test
/tmp/

# Mission/task briefs and local review reports are operator working material,
# not product source or release content.
/mission/

# Session-local Agent object/property ledgers; the user-facing protocol lives
# in prompt/agent-task-record.md, while runtime records are disposable.
/prompt/.agent-task-records/
