# Local agent/tool metadata and generated knowledge graphs. Tracked legacy files
# remain tracked; these rules only prevent new local state from entering commits.
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.gitattributes
graphify-out/
mcps/
.playwright-cli/
.workbuddy/
output/

# One-off local generation scratch files.
scripts/_tmp_*
scripts/_gen_*.py
packages/core/src/scene/_inventory_ext.ts.txt

# Mis-compiled TypeScript output landing inside src/. Every package compiles with
# rootDir=src/outDir=dist, so any emit under src/ is a stray single-file `tsc`
# invocation. Leaving it untracked poisons the handoff fingerprint's untracked
# manifest, so it is ignored outright. Hand-authored declarations stay tracked.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
!apps/desktop/src/renderer/src/global.d.ts

# Local dev launcher (compiled from scripts/launch-soulforge.cs). Do not commit binaries.
/SoulForge.exe

# Electron/app artifacts
release/
*.log

# Playwright transient artifacts
apps/desktop/e2e/playwright/playwright-report/
apps/desktop/e2e/playwright/test-results/
apps/desktop/test-results/
apps/desktop/.native/

# SoulForge local state
.soulforge-local/

# Local real game/mod samples and private fixture evidence. Never commit them.
mods/
Sekiro Shadows Die Twice/
testdata/native-fixtures/


