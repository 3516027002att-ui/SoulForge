<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' != 'Windows_NT'">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="FormatRules\sekiro-face-set-rules.v1.json" />
    <EmbeddedResource Include="FormatRules\sekiro-tae-schema.v1.json.gz.base64" />
  </ItemGroup>

  <Target Name="ValidateFirstPartyHksNativeTarget">
    <Error Condition="('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' != 'win-x64') Or ('$(OS)' != 'Windows_NT' And '$(RuntimeIdentifier)' != 'linux-x64')"
           Text="FIRST_PARTY_HKS_NATIVE_CROSS_TARGET_UNSUPPORTED: Build the native compiler on its Windows/Linux x64 target host; cross-target publishing is unavailable." />
  </Target>

  <Target Name="BuildFirstPartyHksNative" BeforeTargets="Build" DependsOnTargets="ValidateFirstPartyHksNativeTarget">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/build-first-party-hksc-native.mjs&quot; --output &quot;$(OutputPath)&quot;" />
  </Target>

  <Target Name="PublishFirstPartyHksNative" AfterTargets="Publish" DependsOnTargets="ValidateFirstPartyHksNativeTarget">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/build-first-party-hksc-native.mjs&quot; --output &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
