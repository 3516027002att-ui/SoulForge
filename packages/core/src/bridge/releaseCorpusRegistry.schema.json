{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulforge.local/schemas/release-corpus-registry.schema.json",
  "title": "ReleaseCorpusRegistry",
  "description": "SoulForge REL-B release corpus registry（metadata-only，不携带样本字节与本地路径）。本文件是冻结的机器可读格式规格；packages/core/src/bridge/releaseCorpusRegistry.ts 的 TS 常量必须与 x-constants 逐值一致（由 test:release-corpus-registry 同步门禁强制），scripts/verify-native-dcx-documents.mjs 用 x-constants 对账 Bridge 实际 variant 输出。schema 只约束元数据结构，不授予任何 native format authority。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryId",
    "game",
    "gameBuild",
    "schemaVersion",
    "createdAt",
    "entryCount",
    "entries"
  ],
  "properties": {
    "registryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "game": { "$ref": "#/$defs/game" },
    "gameBuild": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
    "schemaVersion": { "const": "1.0.0" },
    "createdAt": { "type": "string", "format": "date-time" },
    "entryCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/registryEntry" }
    }
  },
  "$defs": {
    "game": { "enum": ["sekiro"] },
    "format": { "enum": ["DFLT", "BND4", "KRAK"] },
    "dfltObservedVariant": {
      "enum": [
        "DCX_DFLT_10000_24_9",
        "DCX_DFLT_10000_44_9",
        "DCX_DFLT_10000_44_9_0",
        "DCX_DFLT_11000_44_8",
        "DCX_DFLT_11000_44_9",
        "DCX_DFLT_11000_44_9_0",
        "DCX_DFLT_11000_44_9_15"
      ]
    },
    "bnd4ObservedVariant": { "enum": ["BND4_40_24"] },
    "krakObservedVariant": {
      "enum": ["DCX_KRAK_6", "DCX_KRAK_9", "DCX_KRAK_11000_44_6_0"]
    },
    "operation": {
      "enum": [
        "classify",
        "read",
        "no-op-roundtrip",
        "mutate",
        "repack",
        "reread",
        "preserve-unknown-fields"
      ]
    },
    "privacyClass": { "enum": ["private-game-asset", "private-user-mod", "public-redistributable"] },
    "expectedAuthority": {
      "enum": ["unsupported", "candidate", "partial", "native-verified", "unverified"]
    },
    "resourceKind": {
      "enum": [
        "event",
        "map",
        "param",
        "msg",
        "menu",
        "script",
        "action",
        "ai",
        "sfx",
        "chr",
        "obj",
        "other"
      ]
    },
    "opaqueIdentity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "containerChainItem": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/#:-]{0,255}$" },
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalId",
        "sha256",
        "size",
        "containerChain",
        "resourceKind",
        "format",
        "observedVariant",
        "permittedOperations",
        "expectedAuthority",
        "privacyClass"
      ],
      "properties": {
        "logicalId": { "$ref": "#/$defs/opaqueIdentity" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "containerChain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/containerChainItem" }
        },
        "resourceKind": { "$ref": "#/$defs/resourceKind" },
        "format": { "$ref": "#/$defs/format" },
        "observedVariant": { "type": "string" },
        "permittedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" },
          "contains": { "const": "classify" }
        },
        "expectedAuthority": { "$ref": "#/$defs/expectedAuthority" },
        "privacyClass": { "$ref": "#/$defs/privacyClass" }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "DFLT" } } },
          "then": {
            "properties": { "observedVariant": { "$ref": "#/$defs/dfltObservedVariant" } }
          }
        },
        {
          "if": { "properties": { "format": { "const": "BND4" } } },
          "then": {
            "properties": { "observedVariant": { "$ref": "#/$defs/bnd4ObservedVariant" } }
          }
        },
        {
          "if": { "properties": { "format": { "const": "KRAK" } } },
          "then": {
            "properties": { "observedVariant": { "$ref": "#/$defs/krakObservedVariant" } }
          }
        }
      ]
    }
  },
  "x-constants": {
    "schemaVersion": "1.0.0",
    "maxEntries": 10000,
    "games": ["sekiro"],
    "formats": ["DFLT", "BND4", "KRAK"],
    "observedVariantsByFormat": {
      "DFLT": [
        "DCX_DFLT_10000_24_9",
        "DCX_DFLT_10000_44_9",
        "DCX_DFLT_10000_44_9_0",
        "DCX_DFLT_11000_44_8",
        "DCX_DFLT_11000_44_9",
        "DCX_DFLT_11000_44_9_0",
        "DCX_DFLT_11000_44_9_15"
      ],
      "BND4": ["BND4_40_24"],
      "KRAK": ["DCX_KRAK_6", "DCX_KRAK_9", "DCX_KRAK_11000_44_6_0"]
    },
    "operations": [
      "classify",
      "read",
      "no-op-roundtrip",
      "mutate",
      "repack",
      "reread",
      "preserve-unknown-fields"
    ],
    "privacyClasses": ["private-game-asset", "private-user-mod", "public-redistributable"],
    "expectedAuthorities": ["unsupported", "candidate", "partial", "native-verified", "unverified"],
    "resourceKinds": [
      "event",
      "map",
      "param",
      "msg",
      "menu",
      "script",
      "action",
      "ai",
      "sfx",
      "chr",
      "obj",
      "other"
    ]
  }
}
