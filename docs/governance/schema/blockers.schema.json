{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "soulforge/governance/blockers",
  "title": "SoulForge 结构化 blocker 注册表",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enums", "blockers", "invariants"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string", "minLength": 1 },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "array",
          "items": {
            "enum": [
              "private-corpus",
              "credential",
              "hardware",
              "user-ruling",
              "toolchain",
              "license",
              "upstream",
              "prerequisite-authority"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blockerId",
          "reason",
          "impactRaw",
          "impactGateRefs",
          "impactSliceRefs",
          "owner",
          "requiredInput",
          "unlockValidation",
          "recheckTrigger",
          "evidenceRefs"
        ],
        "properties": {
          "blockerId": { "type": "string", "pattern": "^BLK-[A-Z0-9-]+$" },
          "reason": {
            "enum": [
              "private-corpus",
              "credential",
              "hardware",
              "user-ruling",
              "toolchain",
              "license",
              "upstream",
              "prerequisite-authority"
            ]
          },
          "impactRaw": { "type": "string", "minLength": 1 },
          "impactGateRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^REL-[A-Z-]+$" }
          },
          "impactSliceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^W-[A-Z0-9-]+$" }
          },
          "owner": { "type": "string", "minLength": 1 },
          "requiredInput": { "type": "string", "minLength": 1 },
          "unlockValidation": { "type": "string", "minLength": 1 },
          "recheckTrigger": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" }
          }
        }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
