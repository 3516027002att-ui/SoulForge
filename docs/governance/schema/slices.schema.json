{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "soulforge/governance/slices",
  "title": "SoulForge 执行面板与 active claim 注册表",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enums", "slices", "activeClaims", "invariants"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string", "minLength": 1 },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "authority"],
      "properties": {
        "lifecycle": {
          "type": "array",
          "items": {
            "enum": ["ready", "active", "completed", "blocked", "superseded", "deferred"]
          }
        },
        "authority": {
          "type": "array",
          "items": {
            "enum": [
              "unsupported",
              "candidate",
              "fixture-confirmed",
              "partial",
              "native-verified",
              "unverified"
            ]
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sliceId",
          "targetRelease",
          "lifecycle",
          "authority",
          "authorityCap",
          "authorityCapNote",
          "capabilityIds",
          "blockerRefs",
          "goal",
          "hardPrerequisites",
          "entryPoints",
          "requiredValidation",
          "declaresUnfrozenValidation"
        ],
        "properties": {
          "sliceId": { "type": "string", "pattern": "^W-[A-Z0-9-]+$" },
          "targetRelease": { "type": "string", "pattern": "^V\\d+\\.\\d+$" },
          "lifecycle": {
            "enum": ["ready", "active", "completed", "blocked", "superseded", "deferred"]
          },
          "authority": {
            "enum": [
              "unsupported",
              "candidate",
              "fixture-confirmed",
              "partial",
              "native-verified",
              "unverified"
            ]
          },
          "authorityCap": {
            "enum": [
              "unsupported",
              "candidate",
              "fixture-confirmed",
              "partial",
              "native-verified",
              "unverified"
            ]
          },
          "authorityCapNote": { "type": "string", "minLength": 1 },
          "capabilityIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "blockerRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^BLK-[A-Z0-9-]+$" }
          },
          "goal": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "hardPrerequisites": { "type": "string", "minLength": 1 },
          "entryPoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredValidation": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/definitions/requiredValidationSingle" },
              { "$ref": "#/definitions/requiredValidationSequence" }
            ]
          },
          "declaresUnfrozenValidation": { "type": "boolean" }
        }
      }
    },
    "activeClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sliceId", "claimId", "owner", "claimedAt", "heartbeatAt", "recoveryTrigger"],
        "properties": {
          "sliceId": { "type": "string", "pattern": "^W-[A-Z0-9-]+$" },
          "claimId": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "claimedAt": { "type": "string", "minLength": 1 },
          "heartbeatAt": { "type": "string", "minLength": 1 },
          "recoveryTrigger": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "requiredValidationEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "requiredValidationArgs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredValidationManualChecks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredValidationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId"],
      "properties": {
        "suiteId": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/definitions/requiredValidationArgs" },
        "env": { "$ref": "#/definitions/requiredValidationEnv" }
      }
    },
    "requiredValidationSingle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId"],
      "properties": {
        "suiteId": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/definitions/requiredValidationArgs" },
        "env": { "$ref": "#/definitions/requiredValidationEnv" },
        "manualChecks": { "$ref": "#/definitions/requiredValidationManualChecks" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "requiredValidationSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/requiredValidationStep" }
        },
        "manualChecks": { "$ref": "#/definitions/requiredValidationManualChecks" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
